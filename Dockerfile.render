# Render free-tier demo image: API + Celery worker in ONE container.
# This is the only image that deliberately combines both processes
# (Render background workers have no free tier). It contains TShark
# because the worker needs it. For production, use Dockerfile.api +
# Dockerfile.worker separately (see docker-compose.yml).
FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends tshark \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN groupadd -r app && useradd -r -g app app
RUN pip install --no-cache-dir uv==0.13.5
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
COPY scripts/render_start.sh ./scripts/render_start.sh
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src"
USER app
# No Render "Docker Command" needed: this CMD does migrations, worker, API.
CMD ["sh", "scripts/render_start.sh"]
