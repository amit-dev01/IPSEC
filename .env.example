# Copy to .env for local development only. No real secrets here or in git.
# In production, inject these via the environment / a secret manager.
IPSEC_ENVIRONMENT=development
IPSEC_LOG_LEVEL=INFO
IPSEC_DATABASE_URL=postgresql+psycopg://ipsec:change-me-local-only@localhost:5432/ipsec
IPSEC_REDIS_URL=redis://localhost:6379/0
IPSEC_S3_ENDPOINT_URL=http://localhost:9000
# Development-only: local MinIO over plain http. Production requires TLS (default on).
IPSEC_S3_USE_TLS=false
IPSEC_S3_VERIFY_TLS=true
# IPSEC_S3_SSE_ALGORITHM=AES256        # or aws:kms (+ IPSEC_S3_SSE_KMS_KEY_ID)
# IPSEC_S3_SSE_KMS_KEY_ID=
IPSEC_CAPTURE_RETENTION_DAYS=90
IPSEC_S3_BUCKET=ipsec-captures
IPSEC_S3_ACCESS_KEY=change-me-local-only
IPSEC_S3_SECRET_KEY=change-me-local-only
IPSEC_SECRET_KEY=change-me-local-only-at-least-32-chars
# Optional dedicated JWT signing key (falls back to IPSEC_SECRET_KEY):
IPSEC_JWT_SIGNING_KEY=change-me-local-only-at-least-32-chars
IPSEC_AUTH_ISSUER=ipsec-analyzer
IPSEC_AUTH_AUDIENCE=ipsec-analyzer-api
IPSEC_ACCESS_TOKEN_EXPIRE_MINUTES=15
IPSEC_LOGIN_MAX_ATTEMPTS=5
IPSEC_LOGIN_WINDOW_SECONDS=300
# IPSEC_ENABLE_DOCS=true   # docs are on by default only in development
